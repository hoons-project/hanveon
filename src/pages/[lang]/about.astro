---
import TextLayout from '../../layouts/TextLayout.astro';
import { SUB_LANGS, type Lang } from '../../i18n';
import { ABOUT } from '../../text/about';

export function getStaticPaths() {
  return SUB_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---
<TextLayout lang={lang} slug="about" copy={ABOUT[lang]} />
