---
/*
  영어 대문. 주소는 `/` 다.

  영어만 나라말이 주소에 안 붙는다. 이미 인터넷에 나가 있는 주소라
  `/en/` 으로 옮기면 그동안 쌓인 것이 끊긴다.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import Hub from '../components/Hub.astro';
import { homeJsonLd } from '../seo';
---

<BaseLayout lang="en" kind="home" pageBg="#BFE8FF" jsonLd={homeJsonLd('en', Astro.site!)}>
  <Hub lang="en" />
</BaseLayout>

<script>
  /*
    처음 들어온 사람을 자기 나라말로 보내준다. `/` 에서만 한다.

    - 전에 골라둔 것이 있으면 그것을 따른다
    - 없으면 브라우저 설정을 본다
    - 영어면 여기 그대로 둔다 (검색 로봇은 보통 영어라 여기 머문다)
  */
  const SUB = ['ko', 'ja', 'es', 'fr', 'zh'];
  let go = '';
  try {
    const saved = localStorage.getItem('hanveonLang');
    if (saved && SUB.includes(saved)) go = '/' + saved + '/';
    else if (saved === 'en') go = '';
    else throw 0;
  } catch (e) {
    const want = navigator.languages || [navigator.language || 'en'];
    for (const raw of want) {
      const s = String(raw).toLowerCase();
      if (s.startsWith('en')) break;
      const hit = SUB.find((l) => s.startsWith(l));
      if (hit) { go = '/' + hit + '/'; break; }
    }
  }
  if (go) location.replace(go + location.search + location.hash);
</script>
