---
/* 대문 알맹이. 나라말만 바꿔서 여섯 번 쓰인다. */
import TopBar from './TopBar.astro';
import Foot from './Foot.astro';
import { GAMES, fullName } from '../data/games';
import { gamePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
---

<TopBar lang={lang} kind="home" />

<main class="page">
  <h1 class="pagetitle">{t.tagline}</h1>
  <p class="lede">{t.metaDesc}</p>

  <div class="rowhead"><h2>{t.allGames}</h2></div>

  <div class="cards">
    {
      GAMES.map((g) => (
        <a class="gcard" href={gamePath(lang, g.slug)}>
          <span class="thumb" set:html={g.art} />
          <span class="gname">{fullName(g, lang)}</span>
          <span class="gdesc">{g.desc[lang]}</span>
          <span class="go">{t.play}</span>
        </a>
      ))
    }
  </div>

  <p class="more">{t.more}</p>
</main>

<Foot lang={lang} />
