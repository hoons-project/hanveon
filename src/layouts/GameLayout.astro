---
/*
  게임 한 판을 담는 쪽.

  넓은 화면에서는 왼쪽에 게임, 오른쪽에 읽을 글이 나란히 선다.
  좁으면 위아래로 쌓인다.

  게임마다 다른 알맹이(HUD·캔버스·덮개 화면·손가락 단추)는 slot 으로 받는다.
  읽을 글(소개·어떻게 하나·요령)은 각 게임 `strings.ts` 에서 온다.
*/
import BaseLayout from './BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Foot from '../components/Foot.astro';
import '../styles/game.css';
import { gamePath, homePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { fullName, related, type Game } from '../data/games';
import { gameJsonLd } from '../seo';

interface Props {
  lang: Lang;
  game: Game;
  /** 이름 밑 한 줄 */
  tag: string;
  /** 캔버스 아래 조작 안내. `<br>` 를 쓸 수 있다. */
  help: string;
  /** 읽을 글 */
  about: string;
  how: readonly string[];
  tips: readonly string[];
}

const { lang, game, tag, help, about, how, tips } = Astro.props;
const t = ui(lang);
const name = fullName(game, lang);
const near = related(game, 2);

/* 창 제목과 설명은 검색 결과에 그대로 나온다. 틀은 src/i18n/ui.ts 에 있다. */
const title = t.gameTitle.replace('{name}', name);
const description = `${game.desc[lang]} ${t.gameDescTail}`;
---

<BaseLayout
  lang={lang}
  kind="game"
  slug={game.slug}
  title={title}
  description={description}
  jsonLd={gameJsonLd(game, lang, Astro.site!)}
>
  <TopBar lang={lang} kind="game" slug={game.slug} />

  <main class="page">
    <p class="crumb"><a href={homePath(lang)}>‹ {t.allGames}</a></p>
    <h1 class="pagetitle">{name}</h1>
    <p class="lede">{tag}</p>

    <div class="gamewrap">
      <div class="play">
        <slot />
        <p class="help" set:html={help} />
      </div>

      <div class="guide">
        <section>
          <h2>{t.aboutTitle}</h2>
          <p>{about}</p>
        </section>

        <section>
          <h2>{t.howTitle}</h2>
          <ol>
            {how.map((line, i) => <li data-n={i + 1}>{line}</li>)}
          </ol>
        </section>

        <section>
          <h2>{t.tipsTitle}</h2>
          <ul>
            {tips.map((line) => <li>{line}</li>)}
          </ul>
        </section>
      </div>
    </div>

    <section class="related">
      <h2>{t.moreLike}</h2>
      <div class="relcards">
        {near.map((r) => (
          <a class="relcard" href={gamePath(lang, r.slug)}>
            <span class="relthumb" set:html={r.art} />
            <span class="relname">{fullName(r, lang)}</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Foot lang={lang} />
</BaseLayout>
