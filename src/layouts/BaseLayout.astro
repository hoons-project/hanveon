---
import '../styles/global.css';
import { altPaths, HREFLANG, ogPath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** 이 페이지가 대문인지 게임인지. hreflang 과 대표 그림을 만드는 데 쓴다. */
  kind: 'home' | 'game';
  /** 게임일 때만. */
  slug?: string;
  title?: string;
  description?: string;
  /** 검색엔진에 주는 구조화 자료. 그대로 JSON 으로 박힌다. */
  jsonLd?: unknown;
}

const { lang, kind, slug, title, description, jsonLd } = Astro.props;
const t = ui(lang);

const docTitle = title ?? t.homeTitle;
const desc = description ?? t.metaDesc;

/* 크롤러와 SNS는 상대 주소를 못 푼다. astro.config.mjs 의 site 에서 절대 주소를 만든다. */
const canonical = new URL(Astro.url.pathname, Astro.site);
const alts = altPaths(kind, slug);
const ogImage = new URL(ogPath(kind, lang, slug), Astro.site);
---
<!doctype html>
<html lang={HREFLANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={desc} />
    <title>{docTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* 글씨 — Inter. 한글·일본말·중국말은 기기에 있는 글꼴이 받는다 */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    {/* 같은 페이지의 다른 나라말이 어디 있는지 검색엔진에 알려준다.
        x-default 는 「어느 것도 안 맞으면 여기로」라는 뜻. 영어를 쓴다. */}
    {alts.map((a) => (
      <link rel="alternate" hreflang={HREFLANG[a.lang]} href={new URL(a.path, Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(alts[0]!.path, Astro.site)} />

    <meta name="theme-color" content="#FFFFFF" />
    <meta property="og:site_name" content="Hanveon" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={docTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang} />
    {alts.filter((a) => a.lang !== lang).map((a) => (
      <meta property="og:locale:alternate" content={a.lang} />
    ))}

    {/* 카톡·트위터에 링크를 붙이면 나오는 그림 */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={docTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={docTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    {/* 구조화 자료 — 구글에 「이건 게임이다」라고 알려주는 표시 */}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
