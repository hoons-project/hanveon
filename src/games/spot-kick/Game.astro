---
/*
  뻥뻥 슛 — 끝나지 않는 승부차기.

  다른 여섯 게임과 결이 다르다. 저쪽은 다 「계속 움직이는 것」이라 손이 쉬지 않는데,
  이건 **한 번에 한 번씩 끊어서** 한다. 두 번 누르면 한 번 차고, 결과를 보고, 또 찬다.

  알맹이는 골키퍼다. 앞선 두 번을 기억하고 그쪽으로 기울기 때문에
  같은 구석만 계속 노리면 갈수록 막힌다. 「잘하는 요령」 세 줄이 그래서 참이 된다.

  진짜 팀·선수·리그 이름은 하나도 안 쓴다. 이름 없는 골키퍼와 아무 뜻 없는 색뿐이다.
*/
import GameLayout from '../../layouts/GameLayout.astro';
import { findGame } from '../../data/games';
import type { Lang } from '../../i18n';
import { STR } from './strings';

interface Props { lang: Lang }
const { lang } = Astro.props;

const game = findGame('spot-kick')!;
const T = STR[lang];
---

<GameLayout
  lang={lang}
  game={game}
  tag={T.tagline}
  help={T.help}
  about={T.about}
  how={T.how}
  tips={T.tips}
>
  <div class="hud">
    <div><b>{T.goals}</b><i id="hGoals">0</i></div>
    <div><b>{T.lives}</b><i id="hLives" class="word">♥♥♥</i></div>
    <div><b>{T.best}</b><i id="hBest">0</i></div>
  </div>

  <div class="stage">
    <canvas id="game"></canvas>

    <div class="screen on" id="scReady">
      <div class="card">
        <h2>{T.readyTitle}</h2>
        <p set:html={T.readyBody} />
        <div class="legend">
          <div><i class="chip" style="background:#FF385C"></i><span>{T.legend1}</span></div>
          <div><i class="chip bar" style="background:#FFD23F"></i><span>{T.legend2}</span></div>
          {/* 둘째·셋째는 힘 막대의 두 칸이라 막대꼴로, 첫째는 겨냥 표시라 동그라미로 —
              안 그러면 산호색 동그라미와 빨간 동그라미가 똑같아 보인다 */}
          <div><i class="chip bar" style="background:#EE2233"></i><span>{T.legend3}</span></div>
        </div>
        <button id="btnStart">{T.start}</button>
      </div>
    </div>

    <div class="screen" id="scOver">
      <div class="card">
        <h2>{T.overTitle}</h2>
        <div class="result">
          <div><span>{T.goals}</span><strong id="rGoals">0</strong></div>
          <div><span>{T.best}</span><strong id="rBest">0</strong></div>
        </div>
        <button id="btnRetry">{T.retry}</button>
      </div>
    </div>

    <div class="screen" id="scPause">
      <div class="card">
        <h2>{T.paused}</h2>
        <p>{T.pausedHint}</p>
        <button id="btnResume">{T.resume}</button>
      </div>
    </div>
  </div>

  <style>
    /* 이 게임만 쓰는 것 — 하늘색 바탕. 나머지는 src/styles/game.css 에 있다. */
    canvas{ background:#BFE8FF }
  </style>

  <script define:vars={{ T }}>
(() => {
  const W = 360, H = 620;
  const cv = document.getElementById('game');
  const ctx = cv.getContext('2d');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function fit(){
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  fit();
  addEventListener('resize', fit);

  const INK = '#2A3145';
  const CREAM = '#FFF7EA';
  const SUN = '#FFD23F';
  const CORAL = '#FF385C';
  const SKY = '#BFE8FF';
  const GRASS = '#7FD8C8';
  const GREY = '#B0B0B0';
  const RED = '#EE2233';

  /* ── 자리. 지시서의 좌표를 그대로 쓴다 ──────────────── */
  const SKY_H = 200;          // 하늘과 잔디의 경계
  const POST_L = 44, POST_R = 316, POST_W = 7;
  const BAR_TOP = 96;         // 크로스바 위쪽
  const GOAL_LINE = 214;
  const IN_L = 47.5, IN_R = 312.5, IN_T = 99.5;   // 골문 안쪽 (너비 265)
  const KEEP_W = 40, KEEP_H = 46;
  const SPOT_X = 180, SPOT_Y = 512;
  const BALL_X = 180, BALL_Y = 500, BALL_R = 13;
  const AIM_Y = 205, AIM_L = 62, AIM_R = 298;
  const BAR_X = 328, BAR_X2 = 344, BAR_Y = 372, BAR_Y2 = 560;
  const BAR_H = BAR_Y2 - BAR_Y;                    // 188

  /* ── 숫자. 여기를 바꾸면 「잘하는 요령」이 거짓말이 된다 ── */
  const FLY = 0.55;           // 공이 나는 시간(초)
  const LIVES = 3;
  const RESULT_T = 0.9;       // 판정 글씨가 떠 있는 시간

  const el = (id) => document.getElementById(id);
  const scReady = el('scReady'), scOver = el('scOver'), scPause = el('scPause');
  const hGoals = el('hGoals'), hLives = el('hLives'), hBest = el('hBest');
  const rGoals = el('rGoals'), rBest = el('rBest');

  let state = 'ready';
  /* 멈췄을 때 무슨 상태였는지. 이어 하기로 되돌린다 */
  let paused = null;
  /* 그리는 쪽이 보는 상태 — 멈춤은 덮개일 뿐이라 아래 상태를 그대로 그린다 */
  const eff = () => (state === 'pause' ? paused : state);

  let aimX, aimDir, pwrT, p, ft, targetX, targetY, outcome, resT;
  let keeperX, keeperFrom, keeperTo, keeperTilt;
  let goals, lives, streak, hist;
  let parts, netWob, netX, netY, shake;
  let best = 0;

  function newKick(){
    aimX = (AIM_L + AIM_R) / 2; aimDir = 1;
    pwrT = 0; p = 0; ft = 0;
    targetX = BALL_X; targetY = GOAL_LINE;
    keeperX = 180; keeperFrom = 180; keeperTo = 180; keeperTilt = 0;
    outcome = null; resT = 0;
  }

  function reset(){
    goals = 0; lives = LIVES; streak = 0; hist = [];
    parts = []; netWob = 0; netX = 180; netY = 160; shake = 0;
    newKick();
  }

  /* 갈수록 조금씩 빨라진다 */
  const aimSpeed = () => Math.min(430, 190 + goals * 11);      // px/초
  const pwrRate  = () => Math.min(2.2, 0.85 + goals * 0.05);   // 왕복/초

  /* 힘 막대 — 0 → 1 → 0 을 되풀이하는 톱니 */
  const tri = (x) => { const u = x % 2; return u < 1 ? u : 2 - u; };

  /* 겨냥한 자리가 어느 쪽인지. -1 왼쪽 · 0 가운데 · +1 오른쪽 */
  const side = (x) => (x < 140 ? -1 : x > 220 ? 1 : 0);

  // ── 차기 ────────────────────────────────────────────
  function kick(){
    targetX = aimX;
    targetY = GOAL_LINE - p * 118;      // p=0 → 214(땅) · p=1 → 96(크로스바 높이)

    /* 골키퍼가 어디로 뛸지는 **차는 순간** 정한다.
       앞선 두 번이 같은 쪽이면 그쪽으로 기운다 — 이것이 「방향을 바꿔 가며 차라」를 참으로 만든다 */
    const BIAS = Math.min(0.62, 0.28 + goals * 0.02);
    let zone;
    if (hist.length === 2 && hist[0] === hist[1] && Math.random() < BIAS) {
      zone = hist[0];
    } else {
      zone = [-1, 0, 1][Math.floor(Math.random() * 3)];
    }
    keeperFrom = 180;
    keeperTo = [96, 180, 264][zone + 1] + (Math.random() * 36 - 18);

    /* 기억은 찬 뒤에 밀어 넣는다. 둘만 들고 있는다 */
    hist.push(side(aimX));
    if (hist.length > 2) hist.shift();

    ft = 0;
    state = 'fly';
  }

  // ── 판정. FLY 에 딱 한 번, 위에서부터 차례대로 본다 ──
  function judge(){
    if (p > 0.92) {
      outcome = 'over';
    } else {
      let reach = 46 + Math.min(14, goals * 0.6);   // 갈수록 조금씩 넓어진다
      if (p < 0.28)      reach *= 2;                // 약하게 차면 여유가 생긴다
      if (targetY < 132) reach *= 0.52;             // 위쪽 구석은 손이 잘 안 닿는다
      outcome = Math.abs(targetX - keeperTo) < reach ? 'saved' : 'goal';
    }

    if (outcome === 'goal') {
      goals++; streak++;
      hGoals.textContent = goals;
      netWob = 1; netX = targetX; netY = targetY;
      puff(targetX, targetY, 12, SUN);
      if (goals > best) { best = goals; hBest.textContent = best; saveBest(best); }
    } else {
      streak = 0; lives--;
      hLives.textContent = '♥'.repeat(Math.max(0, lives)) || '—';
      shake = 1;
      puff(targetX, targetY, 7, outcome === 'saved' ? CREAM : '#FF9EA8');
    }

    state = 'result'; resT = 0;
  }

  function over(){
    state = 'over';
    rGoals.textContent = goals;
    rBest.textContent = best;
    show('scOver');
  }

  // ── 조각 ────────────────────────────────────────────
  function puff(x, y, n, c){
    if (reduce) return;
    for (let i = 0; i < n; i++)
      parts.push({ x, y, vx:(Math.random()-.5)*210, vy:(Math.random()-.5)*210 - 40,
                   r: 2.4 + Math.random()*5, life:.35 + Math.random()*.35, max:.7, c });
  }

  // ── 공이 지금 어디 있나 ─────────────────────────────
  function ballAt(){
    const st = eff();
    if (st === 'aim' || st === 'power' || st === 'ready' || st === 'over')
      return { x: BALL_X, y: BALL_Y, r: BALL_R };

    if (st === 'fly') {
      const u = ft / FLY;
      return {
        x: BALL_X + (targetX - BALL_X) * u,
        y: BALL_Y + (targetY - BALL_Y) * u - Math.sin(u * Math.PI) * 18,
        r: BALL_R + (8 - BALL_R) * u,
      };
    }

    /* 판정 뒤에도 공은 멈추지 않는다. 어떻게 됐는지가 눈에 보여야 한다 */
    const s = resT;
    if (outcome === 'over')
      return { x: targetX + (targetX - BALL_X) * s * 0.5, y: targetY - s * 300, r: 8 };
    if (outcome === 'saved') {
      const away = targetX < keeperTo ? -1 : 1;
      return { x: targetX + away * s * 190, y: targetY + s * 130 + s * s * 90, r: 8 };
    }
    return { x: targetX, y: Math.min(GOAL_LINE - 6, targetY + s * 120), r: 8 };
  }

  // ── 그리기 도구 ─────────────────────────────────────
  function rr(x, y, w, h, r){
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x+w, y, x+w, y+h, r);
    ctx.arcTo(x+w, y+h, x, y+h, r);
    ctx.arcTo(x, y+h, x, y, r);
    ctx.arcTo(x, y, x+w, y, r);
    ctx.closePath();
  }
  function fs(fill, lw){
    ctx.fillStyle = fill; ctx.fill();
    ctx.lineWidth = lw || 3; ctx.strokeStyle = INK; ctx.stroke();
  }
  function label(txt, x, y, size, color){
    ctx.font = `900 ${size}px system-ui, sans-serif`;
    ctx.textAlign = 'center';
    ctx.lineJoin = 'round';
    ctx.lineWidth = Math.max(4, size * 0.24); ctx.strokeStyle = INK;
    ctx.strokeText(txt, x, y);
    ctx.fillStyle = color; ctx.fillText(txt, x, y);
  }

  // ── 잔디와 하늘 ─────────────────────────────────────
  function drawPitch(){
    ctx.fillStyle = SKY;  ctx.fillRect(-12, -12, W + 24, SKY_H + 12);
    ctx.fillStyle = GRASS; ctx.fillRect(-12, SKY_H, W + 24, H - SKY_H + 24);

    /* 깎은 자국 — 가로 띠 */
    ctx.fillStyle = 'rgba(255,255,255,.07)';
    for (let y = SKY_H; y < H; y += 68) ctx.fillRect(-12, y, W + 24, 34);

    /* 골라인 */
    ctx.strokeStyle = 'rgba(255,255,255,.75)'; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(0, GOAL_LINE); ctx.lineTo(W, GOAL_LINE); ctx.stroke();

    /* 페널티 점 */
    ctx.beginPath(); ctx.ellipse(SPOT_X, SPOT_Y, 5, 2.6, 0, 0, 6.284);
    ctx.fillStyle = 'rgba(255,255,255,.85)'; ctx.fill();
  }

  // ── 그물. 골이 들어가면 잠깐 출렁인다 ───────────────
  function drawNet(){
    const wob = reduce ? 0 : netWob;
    const swing = Math.sin(netWob * 22);

    ctx.save();
    ctx.globalAlpha = 0.18;
    ctx.strokeStyle = INK; ctx.lineWidth = 1;

    for (let x = IN_L; x <= IN_R + 0.1; x += 22) {
      const off = wob * 9 * Math.exp(-Math.abs(x - netX) / 55) * swing;
      ctx.beginPath();
      ctx.moveTo(x, IN_T);
      ctx.quadraticCurveTo(x + off, netY, x, GOAL_LINE);
      ctx.stroke();
    }
    for (let y = IN_T; y <= GOAL_LINE + 0.1; y += 20) {
      const off = wob * 7 * Math.exp(-Math.abs(y - netY) / 45) * swing;
      ctx.beginPath();
      ctx.moveTo(IN_L, y);
      ctx.quadraticCurveTo(netX, y + off, IN_R, y);
      ctx.stroke();
    }
    ctx.restore();
  }

  // ── 골대. 다른 게임과 같은 잉크 테두리 ──────────────
  function drawFrame(){
    ctx.strokeStyle = INK; ctx.lineWidth = POST_W + 3; ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(POST_L, BAR_TOP + POST_W / 2); ctx.lineTo(POST_L, GOAL_LINE);
    ctx.moveTo(POST_R, BAR_TOP + POST_W / 2); ctx.lineTo(POST_R, GOAL_LINE);
    ctx.moveTo(POST_L, BAR_TOP + POST_W / 2); ctx.lineTo(POST_R, BAR_TOP + POST_W / 2);
    ctx.stroke();

    ctx.strokeStyle = CREAM; ctx.lineWidth = POST_W; ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(POST_L, BAR_TOP + POST_W / 2); ctx.lineTo(POST_L, GOAL_LINE);
    ctx.moveTo(POST_R, BAR_TOP + POST_W / 2); ctx.lineTo(POST_R, GOAL_LINE);
    ctx.moveTo(POST_L, BAR_TOP + POST_W / 2); ctx.lineTo(POST_R, BAR_TOP + POST_W / 2);
    ctx.stroke();
    ctx.lineCap = 'butt';
  }

  // ── 골키퍼 ──────────────────────────────────────────
  function drawKeeper(){
    const away = keeperX - 180;
    const ext = Math.min(1, Math.abs(away) / 84);

    /* 그림자는 땅에 붙어 있다 — 몸과 같이 안 기운다 */
    ctx.globalAlpha = .15; ctx.fillStyle = '#1B2030';
    ctx.beginPath(); ctx.ellipse(keeperX, GOAL_LINE + 2, KEEP_W * .55, 6, 0, 0, 6.284); ctx.fill();
    ctx.globalAlpha = 1;

    ctx.save();
    ctx.translate(keeperX, GOAL_LINE);
    ctx.rotate(keeperTilt);

    /* 팔 — 뛰는 쪽으로 뻗는다. 잉크 테두리에 크림색 속 */
    const dir = away === 0 ? 0 : (away > 0 ? 1 : -1);
    const sy = -KEEP_H + 10;
    ctx.lineCap = 'round';
    for (const pass of [0, 1]) {
      ctx.strokeStyle = pass ? CREAM : INK;
      ctx.lineWidth = pass ? 5 : 10;
      ctx.beginPath();
      for (const s of [-1, 1]) {
        const out = KEEP_W / 2 + 11 + (s === dir ? ext * 17 : ext * 5);
        ctx.moveTo(s * (KEEP_W / 2 - 4), sy);
        ctx.lineTo(s * out, sy - 9 - ext * 7);
      }
      ctx.stroke();
    }

    /* 다리 */
    ctx.strokeStyle = INK; ctx.lineWidth = 9;
    ctx.beginPath();
    for (const s of [-1, 1]) {
      ctx.moveTo(s * 8, -12);
      ctx.lineTo(s * (8 + ext * 9), 0);
    }
    ctx.stroke();
    ctx.lineCap = 'butt';

    /* 몸 — 유니폼 */
    rr(-KEEP_W / 2, -KEEP_H, KEEP_W, KEEP_H, 13);
    fs(SUN, 3.4);
    ctx.save();
    rr(-KEEP_W / 2, -KEEP_H, KEEP_W, KEEP_H, 13); ctx.clip();
    ctx.fillStyle = 'rgba(42,49,69,.14)';
    ctx.fillRect(-KEEP_W / 2, -KEEP_H + 17, KEEP_W, 8);
    ctx.restore();

    /* 머리 */
    ctx.beginPath(); ctx.arc(0, -KEEP_H - 10, 10.5, 0, 6.284);
    fs(CREAM, 3);
    for (const s of [-1, 1]) {
      ctx.beginPath(); ctx.arc(s * 3.6, -KEEP_H - 11, 1.6, 0, 6.284);
      ctx.fillStyle = INK; ctx.fill();
    }
    ctx.globalAlpha = .5; ctx.fillStyle = '#FF9EA8';
    for (const s of [-1, 1]) {
      ctx.beginPath(); ctx.arc(s * 6.6, -KEEP_H - 7, 1.9, 0, 6.284); ctx.fill();
    }
    ctx.globalAlpha = 1;

    ctx.restore();
  }

  // ── 겨냥 표시 ───────────────────────────────────────
  function drawAim(){
    ctx.save();
    ctx.translate(aimX, AIM_Y);

    ctx.beginPath(); ctx.ellipse(0, 4, 13, 5, 0, 0, 6.284);
    ctx.fillStyle = 'rgba(255,56,92,.25)'; ctx.fill();

    ctx.beginPath();
    ctx.moveTo(0, -14); ctx.lineTo(9, -27); ctx.lineTo(-9, -27); ctx.closePath();
    fs(CORAL, 2.6);

    ctx.beginPath(); ctx.arc(0, 0, 7, 0, 6.284);
    fs(CORAL, 2.6);
    ctx.restore();
  }

  // ── 힘 막대 ─────────────────────────────────────────
  function drawPower(){
    const w = BAR_X2 - BAR_X;
    const yAt = (v) => BAR_Y2 - v * BAR_H;

    /* 색 띠 — 어디가 어디인지 늘 보인다 */
    ctx.save();
    rr(BAR_X, BAR_Y, w, BAR_H, 8); ctx.clip();

    ctx.fillStyle = GREY;
    ctx.fillRect(BAR_X, yAt(0.28), w, BAR_H);

    const g = ctx.createLinearGradient(0, yAt(0.28), 0, yAt(0.92));
    g.addColorStop(0, SUN); g.addColorStop(1, CORAL);
    ctx.fillStyle = g;
    ctx.fillRect(BAR_X, yAt(0.92), w, yAt(0.28) - yAt(0.92));

    ctx.fillStyle = RED;
    ctx.fillRect(BAR_X, BAR_Y, w, yAt(0.92) - BAR_Y);

    /* 지금 자리보다 위는 흐리게 — 어디까지 찼는지 한눈에 */
    const st = eff();
    const lv = (st === 'aim' || st === 'ready' || st === 'over') ? 0 : p;
    ctx.fillStyle = 'rgba(255,255,255,.62)';
    ctx.fillRect(BAR_X, BAR_Y, w, yAt(lv) - BAR_Y);
    ctx.restore();

    rr(BAR_X, BAR_Y, w, BAR_H, 8);
    ctx.lineWidth = 3; ctx.strokeStyle = INK; ctx.stroke();

    /* 지금 자리 */
    if (st !== 'ready' && st !== 'over') {
      const y = yAt(lv);
      ctx.strokeStyle = INK; ctx.lineWidth = 3.4; ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(BAR_X - 4, y); ctx.lineTo(BAR_X2 + 4, y); ctx.stroke();
      ctx.lineCap = 'butt';
      ctx.beginPath();
      ctx.moveTo(BAR_X - 7, y); ctx.lineTo(BAR_X - 16, y - 5); ctx.lineTo(BAR_X - 16, y + 5);
      ctx.closePath(); fs(CREAM, 2.4);
    }
  }

  // ── 공 ──────────────────────────────────────────────
  function drawBall(){
    const b = ballAt();
    if (b.y < -40 || b.y > H + 60) return;

    ctx.globalAlpha = .16; ctx.fillStyle = '#1B2030';
    ctx.beginPath(); ctx.ellipse(b.x + 2, Math.min(H - 6, b.y + b.r + 5), b.r * .9, b.r * .34, 0, 0, 6.284);
    ctx.fill();
    ctx.globalAlpha = 1;

    ctx.beginPath(); ctx.arc(b.x, b.y, b.r, 0, 6.284);
    fs(CREAM, Math.max(2.2, b.r * .21));

    /* 가운데 오각형 하나 */
    const r = b.r * .46;
    ctx.beginPath();
    for (let i = 0; i < 5; i++) {
      const a = -Math.PI / 2 + i * (Math.PI * 2 / 5);
      ctx.lineTo(b.x + Math.cos(a) * r, b.y + Math.sin(a) * r);
    }
    ctx.closePath();
    ctx.fillStyle = INK; ctx.fill();
  }

  // ── 한 판 그리기 ────────────────────────────────────
  function draw(){
    const st = eff();

    ctx.save();
    if (shake > 0 && !reduce)
      ctx.translate((Math.random()-.5) * shake * 6, (Math.random()-.5) * shake * 6);

    drawPitch();
    drawNet();
    drawKeeper();
    drawFrame();
    /* 힘을 정하는 동안에도 겨냥한 자리가 보여야 한다 — 그래야 어디로 갈지 안다 */
    if (st === 'aim' || st === 'power') drawAim();
    drawBall();
    drawPower();

    for (const q of parts) {
      const a = Math.max(0, q.life / q.max);
      ctx.globalAlpha = a;
      ctx.beginPath(); ctx.arc(q.x, q.y, q.r * a, 0, 6.284);
      ctx.fillStyle = q.c; ctx.fill();
      ctx.globalAlpha = 1;
    }

    /* 캔버스에 얹는 글씨 */
    if (streak >= 3 && (st === 'aim' || st === 'power' || st === 'result'))
      label(T.streak.replace('{n}', streak), W / 2, 46, 16, SUN);

    if (st === 'aim')   label(T.aimHint, W / 2, 596, 17, CREAM);
    if (st === 'power') label(T.powerHint, W / 2, 596, 17, CREAM);

    if (st === 'result') {
      const txt = outcome === 'goal' ? T.scored : outcome === 'saved' ? T.saved : T.over;
      const col = outcome === 'goal' ? SUN : CREAM;
      label(txt, W / 2, 316, outcome === 'goal' ? 40 : 30, col);
    }

    ctx.restore();
  }

  // ── 흐르는 시간 ─────────────────────────────────────
  function update(dt){
    for (let i = parts.length - 1; i >= 0; i--) {
      const q = parts[i];
      q.life -= dt; q.x += q.vx*dt; q.y += q.vy*dt; q.vx *= .9; q.vy *= .9;
      if (q.life <= 0) parts.splice(i, 1);
    }
    shake = Math.max(0, shake - dt * 3.4);
    netWob = Math.max(0, netWob - dt * 1.6);

    if (state === 'aim') {
      aimX += aimDir * aimSpeed() * dt;
      if (aimX <= AIM_L) { aimX = AIM_L; aimDir = 1; }
      if (aimX >= AIM_R) { aimX = AIM_R; aimDir = -1; }
      return;
    }

    if (state === 'power') {
      pwrT += dt * pwrRate() * 2;      // 한 왕복이 2칸이다
      p = tri(pwrT);
      return;
    }

    if (state === 'fly') {
      ft += dt;
      /* 골키퍼는 0.14초에 출발해서 0.44초에 도착한다 */
      const k = Math.max(0, Math.min(1, (ft - 0.14) / 0.30));
      const e = 1 - Math.pow(1 - k, 3);
      keeperX = keeperFrom + (keeperTo - keeperFrom) * e;
      keeperTilt = ((keeperTo - keeperFrom) / 84) * e * 1.05;
      if (ft >= FLY) { ft = FLY; judge(); }
      return;
    }

    if (state === 'result') {
      resT += dt;
      if (resT >= RESULT_T) {
        if (lives <= 0) { over(); }
        else { newKick(); state = 'aim'; }
      }
    }
  }

  let last = 0;
  function frame(t){
    const dt = Math.min((t - last) / 1000, .04);
    last = t;
    update(dt); draw();
    requestAnimationFrame(frame);
  }

  // ── 덮개 화면과 누르기 ──────────────────────────────
  function show(id){
    for (const s of [scReady, scOver, scPause]) s.classList.toggle('on', s.id === id);
  }
  function start(){
    reset();
    hGoals.textContent = '0';
    hLives.textContent = '♥'.repeat(LIVES);
    state = 'aim';
    show('none');
  }
  function togglePause(){
    if (state === 'ready' || state === 'over') return;
    if (state === 'pause') { state = paused; paused = null; show('none'); }
    else { paused = state; state = 'pause'; show('scPause'); }
  }

  /* 누르는 것 셋이 다 같다 — 손가락·마우스, 스페이스, 엔터 */
  function tap(){
    if (state === 'ready' || state === 'over') { start(); return; }
    if (state === 'aim')   { state = 'power'; pwrT = 0; p = 0; return; }
    if (state === 'power') { kick(); return; }
    /* fly · result · pause 에서는 아무 일도 안 일어난다.
       연달아 눌러서 결과를 건너뛰지 못하게 한다 */
  }

  el('btnStart').onclick = start;
  el('btnRetry').onclick = start;
  el('btnResume').onclick = togglePause;

  cv.addEventListener('pointerdown', (e) => { e.preventDefault(); tap(); });

  addEventListener('keydown', (e) => {
    const k = e.key.toLowerCase();
    if (k === ' ' || k === 'enter') e.preventDefault();
    if (e.repeat) return;
    if (k === 'p') { togglePause(); return; }
    if (k === ' ' || k === 'enter') tap();
  });

  // ── 최고 기록 ───────────────────────────────────────
  // 기기에만 남는다. 서버로 보내지 않는다.
  const KEY = 'kickBest';
  async function saveBest(v){
    try { await window.storage.set(KEY, String(v)); return; } catch (e) {}
    try { localStorage.setItem(KEY, String(v)); } catch (e) {}
  }
  (async () => {
    let raw = null;
    try { const r = await window.storage.get(KEY); raw = r && r.value; } catch (e) {}
    if (raw == null) { try { raw = localStorage.getItem(KEY); } catch (e) {} }
    if (raw) { best = parseInt(raw, 10) || 0; hBest.textContent = best; }
  })();

  reset();
  requestAnimationFrame(frame);
})();
  </script>
</GameLayout>
