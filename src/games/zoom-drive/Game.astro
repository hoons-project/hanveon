---
/*
  붕붕 드라이브.

  전에는 이 게임이 `public/play/zoom-drive/index.html` 한 통짜 파일이었고,
  그 안에서 나라말 여섯 개를 자바스크립트로 갈아 끼웠다.
  이제는 나라말마다 페이지가 따로 나오므로, 글은 처음부터 박혀서 나온다.
  그래서 `LANGS` `pickLang()` `apply()` 같은 것이 여기 없다.
*/
import GameLayout from '../../layouts/GameLayout.astro';
import { findGame } from '../../data/games';
import type { Lang } from '../../i18n';
import { STR } from './strings';

interface Props { lang: Lang }
const { lang } = Astro.props;

const game = findGame('zoom-drive')!;
const T = STR[lang];
---

<GameLayout lang={lang} game={game} tag={T.tagline} help={T.help}>
  <div class="hud">
    <div><b>{T.dist}</b><i id="hDist">0</i></div>
    <div><b>{T.coin}</b><i id="hCoin">0</i></div>
    <div><b>{T.best}</b><i id="hBest">0</i></div>
  </div>

  <div class="stage">
    <canvas id="game"></canvas>

    <div class="screen on" id="scReady">
      <div class="card">
        <h2>{T.readyTitle}</h2>
        <p set:html={T.readyBody} />
        <button id="btnStart">{T.start}</button>
      </div>
    </div>

    <div class="screen" id="scOver">
      <div class="card">
        <h2>{T.overTitle}</h2>
        <div class="result">
          <div><span>{T.dist}</span><strong id="rDist">0</strong></div>
          <div><span>{T.coin}</span><strong id="rCoin">0</strong></div>
        </div>
        <button id="btnRetry">{T.retry}</button>
      </div>
    </div>

    <div class="screen" id="scPause">
      <div class="card">
        <h2>{T.paused}</h2>
        <p>{T.pausedHint}</p>
        <button id="btnResume">{T.resume}</button>
      </div>
    </div>
  </div>

  <div class="pad">
    <button id="padL" aria-label={T.padLeft}>◀</button>
    <button id="padR" aria-label={T.padRight}>▶</button>
  </div>

  <style>
    /* 이 게임만 쓰는 것 — 캔버스 바탕 풀색. 나머지는 src/styles/game.css 에 있다. */
    canvas{ background:#6BC48A }
  </style>

  <script define:vars={{ T }}>
(() => {
  const W = 360, H = 620;
  const cv = document.getElementById('game');
  const ctx = cv.getContext('2d');

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function fit(){
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = W * dpr;
    cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  fit();
  window.addEventListener('resize', fit);

  // ── 색 ─────────────────────────────────────────────
  const C = {
    ink:'#2A3145', road:'#59637A', roadDark:'#4B5468', dash:'#FFF1C1',
    grass:'#8FD9A8', grassDeep:'#6BC48A', cream:'#FFF7EA',
    sun:'#FFD23F', coral:'#FF7A6B', glass:'#CFE7FF'
  };
  const FOE = ['#FF7A6B','#7FB8FF','#B79BFF','#FF9ECF','#7FD8C8','#FFA45B'];

  // ── 길 ─────────────────────────────────────────────
  const ROAD_L = 60, ROAD_R = 300;
  const LANES = [100, 180, 260];
  const PLAYER_Y = H - 112;
  const CAR_W = 52, CAR_H = 88;

  // ── 상태 ───────────────────────────────────────────
  let state = 'ready';
  let lane, carX, speed, dist, coins, elapsed;
  let foes, gems, parts, bushes;
  let dashOff, spawnGap, gemGap, shake, blinkT, lastPair, tilt;
  let best = 0;

  function reset(){
    lane = 1; carX = LANES[1];
    speed = 250; dist = 0; coins = 0; elapsed = 0;
    foes = []; gems = []; parts = [];
    dashOff = 0; spawnGap = 300; gemGap = 520;
    shake = 0; blinkT = 2.4; lastPair = false; tilt = 0;
    bushes = [];
    for (let i = 0; i < 14; i++) {
      bushes.push({
        x: Math.random() < .5 ? 8 + Math.random()*40 : 312 + Math.random()*40,
        y: Math.random() * H,
        r: 9 + Math.random()*7,
        c: Math.random() < .25 ? C.sun : C.grassDeep
      });
    }
  }
  reset();

  // ── 그리기 도구 ────────────────────────────────────
  function rr(x, y, w, h, r){
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }
  function fillStroke(fill, lw){
    ctx.fillStyle = fill; ctx.fill();
    ctx.lineWidth = lw || 3; ctx.strokeStyle = C.ink; ctx.stroke();
  }

  // dir: -1 = 위를 보는 내 차, 1 = 아래로 오는 차
  function drawCar(cx, cy, color, dir, face, rot){
    const x = -CAR_W/2, y = -CAR_H/2;
    ctx.save();
    ctx.translate(cx, cy);
    if (rot) ctx.rotate(rot);

    // 그림자
    ctx.globalAlpha = .16;
    ctx.fillStyle = '#1B2030';
    rr(x + 4, y + 8, CAR_W, CAR_H, 15); ctx.fill();
    ctx.globalAlpha = 1;

    // 바퀴
    ctx.fillStyle = '#333A4D';
    rr(x - 5, y + 14, 9, 22, 4); ctx.fill();
    rr(x + CAR_W - 4, y + 14, 9, 22, 4); ctx.fill();
    rr(x - 5, y + CAR_H - 36, 9, 22, 4); ctx.fill();
    rr(x + CAR_W - 4, y + CAR_H - 36, 9, 22, 4); ctx.fill();

    // 몸통
    rr(x, y, CAR_W, CAR_H, 15);
    fillStroke(color, 3.5);

    // 앞유리 (앞쪽에)
    const wy = dir < 0 ? y + 14 : y + CAR_H - 36;
    rr(x + 8, wy, CAR_W - 16, 22, 8);
    fillStroke(C.glass, 2.5);

    // 뒷유리
    const by = dir < 0 ? y + CAR_H - 30 : y + 8;
    ctx.globalAlpha = .75;
    rr(x + 11, by, CAR_W - 22, 16, 7);
    fillStroke(C.glass, 2.5);
    ctx.globalAlpha = 1;

    // 전조등
    const ly = dir < 0 ? y + 4 : y + CAR_H - 11;
    ctx.fillStyle = '#FFF6C9';
    rr(x + 7, ly, 12, 7, 3); ctx.fill();
    rr(x + CAR_W - 19, ly, 12, 7, 3); ctx.fill();

    // 얼굴 (내 차만)
    if (face) {
      const ey = y + 30, open = face.open;
      for (const ex of [x + 17, x + CAR_W - 17]) {
        ctx.fillStyle = '#fff';
        ctx.beginPath();
        ctx.ellipse(ex, ey, 7, 7 * open + .6, 0, 0, 6.284);
        ctx.fill();
        ctx.lineWidth = 2; ctx.strokeStyle = C.ink; ctx.stroke();
        if (open > .35) {
          ctx.fillStyle = C.ink;
          ctx.beginPath();
          ctx.arc(ex + face.look * 2.4, ey + 1, 3.1, 0, 6.284);
          ctx.fill();
        }
      }
    }
    ctx.restore();
  }

  function drawCoin(cx, cy, t){
    const s = Math.abs(Math.cos(t));
    ctx.save();
    ctx.translate(cx, cy);
    ctx.scale(.35 + s * .65, 1);
    ctx.beginPath(); ctx.arc(0, 0, 12, 0, 6.284);
    fillStroke(C.sun, 3);
    ctx.beginPath(); ctx.arc(0, 0, 6, 0, 6.284);
    ctx.lineWidth = 2.4; ctx.strokeStyle = 'rgba(42,49,69,.45)'; ctx.stroke();
    ctx.restore();
  }

  function puff(x, y, n, color){
    for (let i = 0; i < n; i++) {
      parts.push({
        x, y,
        vx: (Math.random() - .5) * 150,
        vy: (Math.random() - .5) * 150 - 40,
        r: 4 + Math.random() * 9,
        life: .5 + Math.random() * .5, max: 1,
        c: color
      });
    }
  }
  function popText(x, y, txt){
    parts.push({ x, y, vx: 0, vy: -60, txt, life: .8, max: .8, c: C.sun });
  }

  // ── 움직임 ─────────────────────────────────────────
  function move(d){
    if (state !== 'play') return;
    const n = Math.max(0, Math.min(2, lane + d));
    if (n !== lane) { lane = n; tilt = d * .16; }
  }

  function spawnFoes(){
    let pair = !lastPair && elapsed > 14 && Math.random() < .34;
    const order = [0, 1, 2].sort(() => Math.random() - .5);
    const use = order.slice(0, pair ? 2 : 1);
    for (const l of use) {
      foes.push({
        lane: l, x: LANES[l], y: -CAR_H,
        c: FOE[(Math.random() * FOE.length) | 0],
        rel: 20 + Math.random() * 55
      });
    }
    lastPair = pair;
  }

  function spawnGems(){
    const l = (Math.random() * 3) | 0;
    const busy = foes.some(f => f.lane === l && f.y < 40);
    if (busy) return;
    for (let i = 0; i < 3; i++) gems.push({ x: LANES[l], y: -30 - i * 44, t: Math.random() * 3 });
  }

  function crash(){
    state = 'over';
    shake = reduce ? 0 : 14;
    puff(carX, PLAYER_Y - 20, 16, '#EEF2F7');
    puff(carX, PLAYER_Y - 20, 8, C.coral);
    const total = Math.floor(dist / 10) + coins * 10;
    if (total > best) { best = total; hBest.textContent = best; saveBest(best); }
    rDist.textContent = Math.floor(dist / 10);
    rCoin.textContent = coins;
    show('scOver');
  }

  // ── 업데이트 ───────────────────────────────────────
  function update(dt){
    blinkT -= dt;
    if (blinkT < -.14) blinkT = 2 + Math.random() * 2.6;
    tilt *= Math.pow(.001, dt);
    shake *= Math.pow(.02, dt);

    for (let i = parts.length - 1; i >= 0; i--) {
      const p = parts[i];
      p.life -= dt;
      p.x += p.vx * dt; p.y += p.vy * dt;
      p.vx *= .94; p.vy *= .94;
      if (p.life <= 0) parts.splice(i, 1);
    }

    // 준비 화면에서는 길만 천천히 흐른다
    if (state !== 'play') {
      if (state === 'ready') {
        dashOff = (dashOff + 60 * dt) % 56;
        for (const b of bushes) { b.y += 60 * dt; if (b.y > H + 20) b.y = -20; }
      }
      return;
    }

    elapsed += dt;
    speed = Math.min(560, 250 + elapsed * 11);
    const dy = speed * dt;
    dist += dy;
    dashOff = (dashOff + dy) % 56;

    for (const b of bushes) {
      b.y += dy;
      if (b.y > H + 20) {
        b.y = -20;
        b.x = Math.random() < .5 ? 8 + Math.random() * 40 : 312 + Math.random() * 40;
      }
    }

    carX += (LANES[lane] - carX) * Math.min(1, dt * 14);

    // 다른 차
    spawnGap -= dy;
    if (spawnGap <= 0) {
      spawnFoes();
      const f = Math.max(.62, .95 - elapsed * .004);
      spawnGap = speed * f + Math.random() * 80;
    }
    for (let i = foes.length - 1; i >= 0; i--) {
      const f = foes[i];
      f.y += (speed + f.rel) * dt;
      if (f.y > H + CAR_H) { foes.splice(i, 1); continue; }
      if (Math.abs(f.x - carX) < CAR_W - 12 && Math.abs(f.y - PLAYER_Y) < CAR_H - 16) {
        crash(); return;
      }
    }

    // 동전
    gemGap -= dy;
    if (gemGap <= 0) { spawnGems(); gemGap = 700 + Math.random() * 500; }
    for (let i = gems.length - 1; i >= 0; i--) {
      const g = gems[i];
      g.y += speed * dt; g.t += dt * 3.4;
      if (g.y > H + 30) { gems.splice(i, 1); continue; }
      if (Math.abs(g.x - carX) < 34 && Math.abs(g.y - PLAYER_Y) < 50) {
        gems.splice(i, 1);
        coins++;
        puff(g.x, g.y, 5, C.sun);
        popText(g.x, g.y - 6, T.coinPop.replace('{n}', 10));
      }
    }

    hDist.textContent = Math.floor(dist / 10);
    hCoin.textContent = coins;
  }

  // ── 화면 ───────────────────────────────────────────
  function draw(){
    ctx.save();
    if (shake > .4) ctx.translate((Math.random() - .5) * shake, (Math.random() - .5) * shake);

    // 잔디
    ctx.fillStyle = C.grass;
    ctx.fillRect(-20, -20, W + 40, H + 40);

    for (const b of bushes) {
      ctx.beginPath(); ctx.arc(b.x, b.y, b.r, 0, 6.284);
      ctx.fillStyle = b.c; ctx.fill();
      ctx.lineWidth = 2.5; ctx.strokeStyle = 'rgba(42,49,69,.35)'; ctx.stroke();
    }

    // 길
    ctx.fillStyle = C.road;
    ctx.fillRect(ROAD_L, -20, ROAD_R - ROAD_L, H + 40);
    ctx.fillStyle = C.roadDark;
    ctx.fillRect(ROAD_L, -20, 8, H + 40);
    ctx.fillRect(ROAD_R - 8, -20, 8, H + 40);

    // 갓길 선
    ctx.fillStyle = C.cream;
    ctx.fillRect(ROAD_L + 11, -20, 4, H + 40);
    ctx.fillRect(ROAD_R - 15, -20, 4, H + 40);

    // 가운데 점선
    ctx.fillStyle = C.dash;
    for (const x of [138, 218]) {
      for (let y = -56 + dashOff; y < H + 56; y += 56) {
        rr(x, y, 6, 30, 3); ctx.fill();
      }
    }

    for (const g of gems) drawCoin(g.x, g.y, g.t);
    for (const f of foes) drawCar(f.x, f.y, f.c, 1, null, 0);

    if (state !== 'over') {
      const open = blinkT < 0 ? .06 : 1;
      const look = (LANES[lane] - carX) / -70;
      drawCar(carX, PLAYER_Y, C.sun, -1, { open, look: Math.max(-1, Math.min(1, look)) }, reduce ? 0 : tilt);
    } else {
      drawCar(carX, PLAYER_Y, C.sun, -1, { open: .06, look: 0 }, .35);
    }

    for (const p of parts) {
      const a = Math.max(0, p.life / p.max);
      ctx.globalAlpha = a;
      if (p.txt) {
        ctx.fillStyle = C.cream;
        ctx.font = '900 20px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.strokeStyle = C.ink; ctx.lineWidth = 4;
        ctx.strokeText(p.txt, p.x, p.y);
        ctx.fillText(p.txt, p.x, p.y);
      } else {
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r * a, 0, 6.284);
        ctx.fillStyle = p.c; ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    ctx.restore();
  }

  let last = 0;
  function frame(t){
    const dt = Math.min((t - last) / 1000, .05);
    last = t;
    update(dt);
    draw();
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);

  // ── 조작 ───────────────────────────────────────────
  const scReady = document.getElementById('scReady');
  const scOver = document.getElementById('scOver');
  const scPause = document.getElementById('scPause');
  const hDist = document.getElementById('hDist');
  const hCoin = document.getElementById('hCoin');
  const hBest = document.getElementById('hBest');
  const rDist = document.getElementById('rDist');
  const rCoin = document.getElementById('rCoin');

  function show(id){
    for (const s of [scReady, scOver, scPause]) s.classList.toggle('on', s.id === id);
  }
  function hideAll(){ show('none'); }

  function start(){
    reset();
    hDist.textContent = '0'; hCoin.textContent = '0';
    state = 'play';
    hideAll();
  }
  function togglePause(){
    if (state === 'play') { state = 'pause'; show('scPause'); }
    else if (state === 'pause') { state = 'play'; hideAll(); }
  }

  document.getElementById('btnStart').onclick = start;
  document.getElementById('btnRetry').onclick = start;
  document.getElementById('btnResume').onclick = togglePause;
  document.getElementById('padL').onclick = () => move(-1);
  document.getElementById('padR').onclick = () => move(1);

  addEventListener('keydown', e => {
    const k = e.key.toLowerCase();
    if (['arrowleft','arrowright',' ','arrowup','arrowdown'].includes(k)) e.preventDefault();
    if (k === 'arrowleft' || k === 'a') move(-1);
    else if (k === 'arrowright' || k === 'd') move(1);
    else if (k === 'p') togglePause();
    else if (k === ' ' || k === 'enter') {
      if (state === 'ready' || state === 'over') start();
    }
  });

  cv.addEventListener('pointerdown', e => {
    if (state === 'ready' || state === 'over') { start(); return; }
    const r = cv.getBoundingClientRect();
    move(e.clientX - r.left < r.width / 2 ? -1 : 1);
  });

  // ── 최고 기록 ───────────────────────────────────────
  // 기기에만 남는다. 서버로 보내지 않는다.
  const KEY = 'best';
  async function saveBest(v){
    try { await window.storage.set(KEY, String(v)); return; } catch (e) {}
    try { localStorage.setItem(KEY, String(v)); } catch (e) {}
  }
  (async () => {
    let raw = null;
    try { const r = await window.storage.get(KEY); raw = r && r.value; } catch (e) {}
    if (raw == null) { try { raw = localStorage.getItem(KEY); } catch (e) {} }
    if (raw) { best = parseInt(raw, 10) || 0; hBest.textContent = best; }
  })();
})();
  </script>
</GameLayout>
