---
/*
  몽글 과일.

  전에는 이 게임이 `public/play/merge-fruit/index.html` 한 통짜 파일이었고,
  그 안에서 나라말 여섯 개를 자바스크립트로 갈아 끼웠다.
  이제는 나라말마다 페이지가 따로 나오므로, 글은 처음부터 박혀서 나온다.
  그래서 `LANGS` `pickLang()` `apply()` 같은 것이 여기 없다.
*/
import GameLayout from '../../layouts/GameLayout.astro';
import { findGame } from '../../data/games';
import type { Lang } from '../../i18n';
import { STR } from './strings';

interface Props { lang: Lang }
const { lang } = Astro.props;

const game = findGame('merge-fruit')!;
const T = STR[lang];
---

<GameLayout
  lang={lang}
  game={game}
  tag={T.tagline}
  help={T.help}
  about={T.about}
  how={T.how}
  tips={T.tips}
>
  <div class="hud">
    <div><b>{T.score}</b><i id="hScore">0</i></div>
    <div><b>{T.big}</b><i id="hBig" class="word">{T.fruits[0]}</i></div>
    <div><b>{T.best}</b><i id="hBest">0</i></div>
  </div>

  <div class="stage">
    <canvas id="game"></canvas>

    <div class="screen on" id="scReady">
      <div class="card">
        <h2>{T.readyTitle}</h2>
        <p set:html={T.readyBody} />
        <div class="chain" id="chain"></div>
        <button id="btnStart">{T.start}</button>
      </div>
    </div>

    <div class="screen" id="scOver">
      <div class="card">
        <h2>{T.overTitle}</h2>
        <div class="result">
          <div><span>{T.score}</span><strong id="rScore">0</strong></div>
          <div><span>{T.big}</span><strong id="rBig" class="word">{T.fruits[0]}</strong></div>
        </div>
        <button id="btnRetry">{T.retry}</button>
      </div>
    </div>

    <div class="screen" id="scPause">
      <div class="card">
        <h2>{T.paused}</h2>
        <p>{T.pausedHint}</p>
        <button id="btnResume">{T.resume}</button>
      </div>
    </div>
  </div>

  <div class="pad">
    <button id="padL" aria-label={T.padLeft}>◀</button>
    <button id="padDrop" class="drop">{T.padDrop}</button>
    <button id="padR" aria-label={T.padRight}>▶</button>
  </div>

  <style>
    /* 이 게임만 쓰는 것. 나머지는 src/styles/game.css 에 있다. */
    canvas{ background:#FFE8D2 }

    /* 합쳐지는 순서 줄. 안쪽 동그라미와 「›」 는 게임 스크립트가 만들기 때문에
       Astro 의 자리표가 안 붙는다. 그래서 :global() 로 적는다. */
    .chain{
      display:flex;flex-wrap:wrap;align-items:center;justify-content:center;
      gap:5px;margin:0 0 16px;
    }
    .chain :global(i){
      display:block;border:2.5px solid var(--ink);border-radius:50%;
    }
    .chain :global(u){text-decoration:none;font-size:11px;font-weight:800;color:#9AA1B2}

    /* 가운데 「놓기」 단추만 노랗고 조금 넓다 */
    .pad button.drop{background:var(--sun);font-size:16px;flex:1.2}
  </style>

  <script define:vars={{ T }}>
(() => {
  const W = 360, H = 620;
  const cv = document.getElementById('game');
  const ctx = cv.getContext('2d');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function fit(){
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  fit();
  addEventListener('resize', fit);

  const INK = '#2A3145';

  // ── 과일 목록 ───────────────────────────────────────
  const FRUIT = [
    { r:13, c:'#8FD14F', d:'#6FB334' },
    { r:18, c:'#FF6B7A', d:'#E14A5B' },
    { r:23, c:'#9B7FE0', d:'#7C5FC4' },
    { r:29, c:'#FF9F45', d:'#E07E24' },
    { r:35, c:'#FFE066', d:'#E7C233' },
    { r:42, c:'#EF4B4B', d:'#CB2F2F' },
    { r:51, c:'#DCE07A', d:'#BCC155' },
    { r:61, c:'#FFB0C4', d:'#E88BA2' },
    { r:72, c:'#F2A93B', d:'#D08B22' },
    { r:84, c:'#B8E3A0', d:'#93C67A' },
    { r:97, c:'#3FA95B', d:'#2C8544' }
  ];
  const TOP = FRUIT.length - 1;
  const BAG = [0,0,0,1,1,1,2,2,3];      // 처음에 나오는 과일

  // ── 통 ──────────────────────────────────────────────
  const BOX = { l:32, r:328, b:596, t:206 };   // 안쪽 기준
  const DROP_Y = 128;
  const WALL = 7;

  // ── 물리 값 ─────────────────────────────────────────
  const G = 2100;          // 중력
  const REST = 0.08;       // 튕김
  const WALL_REST = 0.15;
  const AIR = 0.9995;
  const FRICT = 0.985;

  let balls, parts, score, best = 0, bigTier, state;
  let aim, cur, next, cooldown, comboT, combo, shake;
  let overT;

  function pick(){ return BAG[(Math.random() * BAG.length) | 0]; }

  function reset(){
    balls = []; parts = [];
    score = 0; bigTier = 0; state = 'ready';
    aim = W/2; cur = pick(); next = pick();
    cooldown = 0; comboT = 0; combo = 0; shake = 0; overT = 0;
  }

  function addBall(x, y, tier, vx, vy, landed){
    balls.push({
      x, y, tier, r: FRUIT[tier].r,
      m: FRUIT[tier].r * FRUIT[tier].r,
      vx: vx || 0, vy: vy || 0,
      landed: !!landed, over: 0, pop: 0, born: 0
    });
    return balls[balls.length - 1];
  }

  // ── 조작 ────────────────────────────────────────────
  function clampAim(){
    const r = FRUIT[cur].r;
    aim = Math.max(BOX.l + r, Math.min(BOX.r - r, aim));
  }

  function drop(){
    if (state !== 'play' || cooldown > 0) return;
    clampAim();
    addBall(aim, DROP_Y, cur, 0, 120, false);
    cur = next; next = pick();
    clampAim();
    cooldown = 0.42;
  }

  // ── 합치기 ──────────────────────────────────────────
  function merge(a, b){
    const t = a.tier;
    const x = (a.x * a.m + b.x * b.m) / (a.m + b.m);
    const y = (a.y * a.m + b.y * b.m) / (a.m + b.m);

    a.gone = true; b.gone = true;

    combo = comboT > 0 ? combo + 1 : 1;
    comboT = 0.85;

    const base = (t + 1) * (t + 2) / 2;
    const gain = base * combo;
    score += gain;

    if (t + 1 <= TOP) {
      const nb = addBall(x, y, t + 1, (a.vx + b.vx) * .3, Math.min(a.vy, b.vy) * .3 - 60, true);
      nb.pop = 1;
      if (t + 1 > bigTier) bigTier = t + 1;
      if (t + 1 === TOP) shake = Math.max(shake, 9);
    } else {
      // 수박 두 개 — 둘 다 사라지고 큰 점수
      score += 300;
      shake = Math.max(shake, 14);
      if (!reduce) puff(x, y, 22, FRUIT[TOP].c, 90);
    }

    if (!reduce) puff(x, y, 9 + t, FRUIT[t].c, 40 + t * 6);
    popText(x, y - FRUIT[t].r - 6, combo > 1 ? '+' + gain + ' x' + combo : '+' + gain);
  }

  function puff(x, y, n, c, spread){
    for (let i = 0; i < n; i++) {
      const a = Math.random() * 6.284, s = (spread || 60) * (.4 + Math.random());
      parts.push({ x, y, vx: Math.cos(a)*s, vy: Math.sin(a)*s - 30,
                   r: 3 + Math.random()*6, life:.35 + Math.random()*.45, max:.8, c });
    }
  }
  function popText(x, y, txt){
    parts.push({ x, y, vx:0, vy:-70, txt, life:.85, max:.85 });
  }

  // ── 한 걸음 ─────────────────────────────────────────
  function step(h){
    for (const b of balls) {
      b.born += h;
      b.vy += G * h;
      b.vx *= AIR; b.vy *= AIR;
      b.x += b.vx * h;
      b.y += b.vy * h;
    }

    for (let pass = 0; pass < 3; pass++) {
      // 과일끼리
      for (let i = 0; i < balls.length; i++) {
        const a = balls[i];
        if (a.gone) continue;
        for (let j = i + 1; j < balls.length; j++) {
          const b = balls[j];
          if (b.gone) continue;
          let dx = b.x - a.x, dy = b.y - a.y;
          let d2 = dx*dx + dy*dy;
          const rr = a.r + b.r;
          if (d2 >= rr*rr || d2 === 0) continue;

          let d = Math.sqrt(d2);
          const nx = dx/d, ny = dy/d;

          if (a.tier === b.tier) { merge(a, b); break; }

          a.landed = true; b.landed = true;

          const ov = rr - d;
          const im = 1/a.m + 1/b.m;
          const ca = (1/a.m) / im, cb = (1/b.m) / im;
          a.x -= nx * ov * ca * .8; a.y -= ny * ov * ca * .8;
          b.x += nx * ov * cb * .8; b.y += ny * ov * cb * .8;

          const rvx = b.vx - a.vx, rvy = b.vy - a.vy;
          const vn = rvx*nx + rvy*ny;
          if (vn < 0) {
            const jimp = -(1 + REST) * vn / im;
            a.vx -= jimp * nx / a.m; a.vy -= jimp * ny / a.m;
            b.vx += jimp * nx / b.m; b.vy += jimp * ny / b.m;
          }
          // 미끄럼 줄이기
          const tx = -ny, ty = nx;
          const vt = (b.vx - a.vx)*tx + (b.vy - a.vy)*ty;
          const jt = -vt * .12 / im;
          a.vx -= jt * tx / a.m; a.vy -= jt * ty / a.m;
          b.vx += jt * tx / b.m; b.vy += jt * ty / b.m;
        }
      }

      // 벽과 바닥
      for (const b of balls) {
        if (b.gone) continue;
        if (b.x - b.r < BOX.l) { b.x = BOX.l + b.r; if (b.vx < 0) b.vx *= -WALL_REST; b.landed = true; }
        if (b.x + b.r > BOX.r) { b.x = BOX.r - b.r; if (b.vx > 0) b.vx *= -WALL_REST; b.landed = true; }
        if (b.y + b.r > BOX.b) {
          b.y = BOX.b - b.r;
          if (b.vy > 0) b.vy *= -WALL_REST;
          b.vx *= FRICT;
          b.landed = true;
        }
      }
    }

    for (let i = balls.length - 1; i >= 0; i--) if (balls[i].gone) balls.splice(i, 1);
  }

  // ── 업데이트 ────────────────────────────────────────
  function update(dt){
    for (let i = parts.length - 1; i >= 0; i--) {
      const p = parts[i];
      p.life -= dt; p.x += p.vx*dt; p.y += p.vy*dt; p.vx *= .93; p.vy *= .93;
      if (p.life <= 0) parts.splice(i, 1);
    }
    shake *= Math.pow(.02, dt);
    if (comboT > 0) { comboT -= dt; if (comboT <= 0) combo = 0; }

    if (state !== 'play') return;

    if (cooldown > 0) cooldown -= dt;

    const sub = 4, h = dt / sub;
    for (let s = 0; s < sub; s++) step(h);

    for (const b of balls) if (b.pop > 0) b.pop = Math.max(0, b.pop - dt * 3.2);

    // 넘쳤는지
    let danger = 0;
    for (const b of balls) {
      if (b.landed && b.y - b.r < BOX.t) { b.over += dt; danger = Math.max(danger, b.over); }
      else b.over = 0;
    }
    overT = danger;
    if (danger > 1.5) over();

    hScore.textContent = score;
    hBig.textContent = T.fruits[bigTier];
  }

  function over(){
    state = 'over';
    if (score > best) { best = score; hBest.textContent = best; saveBest(best); }
    rScore.textContent = score;
    rBig.textContent = T.fruits[bigTier];
    show('scOver');
  }

  // ── 그리기 ──────────────────────────────────────────
  function rr(x, y, w, h, r){
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x+w, y, x+w, y+h, r);
    ctx.arcTo(x+w, y+h, x, y+h, r);
    ctx.arcTo(x, y+h, x, y, r);
    ctx.arcTo(x, y, x+w, y, r);
    ctx.closePath();
  }

  function drawFruit(x, y, tier, pop, plain){
    const f = FRUIT[tier];
    const k = f.r / 11;
    const sq = pop ? 1 + pop * .22 : 1;
    ctx.save();
    ctx.translate(x, y);
    ctx.scale(sq, 2 - sq);

    if (!plain) {
      ctx.globalAlpha = .14; ctx.fillStyle = '#1B2030';
      ctx.beginPath(); ctx.arc(2.5, 4, f.r, 0, 6.284); ctx.fill();
      ctx.globalAlpha = 1;
    }

    // 몸
    ctx.beginPath(); ctx.arc(0, 0, f.r, 0, 6.284);
    ctx.fillStyle = f.c; ctx.fill();
    ctx.lineWidth = Math.max(2.4, 3.2 * Math.min(1.4, k)); ctx.strokeStyle = INK; ctx.stroke();

    // 아래쪽 진한 부분
    ctx.save();
    ctx.beginPath(); ctx.arc(0, 0, f.r, 0, 6.284); ctx.clip();
    ctx.globalAlpha = .35; ctx.fillStyle = f.d;
    ctx.beginPath(); ctx.arc(0, f.r * .85, f.r * .95, 0, 6.284); ctx.fill();
    ctx.globalAlpha = 1;
    ctx.restore();

    // 반짝임
    ctx.globalAlpha = .55; ctx.fillStyle = '#FFFFFF';
    ctx.beginPath();
    ctx.ellipse(-f.r*.38, -f.r*.44, f.r*.24, f.r*.16, -.7, 0, 6.284);
    ctx.fill();
    ctx.globalAlpha = 1;

    // 꼭지
    if (tier >= 3) {
      ctx.save();
      ctx.translate(f.r*.18, -f.r + 1);
      ctx.rotate(-.35);
      ctx.beginPath();
      ctx.ellipse(0, -f.r*.12, f.r*.30, f.r*.14, .2, 0, 6.284);
      ctx.fillStyle = '#7FC46A'; ctx.fill();
      ctx.lineWidth = Math.max(2, 2.6 * Math.min(1.3, k)); ctx.strokeStyle = INK; ctx.stroke();
      ctx.restore();
    }

    // 얼굴
    const ex = f.r * .34, ey = -f.r * .06, er = Math.max(1.8, f.r * .105);
    ctx.fillStyle = INK;
    ctx.beginPath(); ctx.arc(-ex, ey, er, 0, 6.284); ctx.fill();
    ctx.beginPath(); ctx.arc( ex, ey, er, 0, 6.284); ctx.fill();

    ctx.lineWidth = Math.max(1.6, f.r * .075); ctx.strokeStyle = INK;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.arc(0, ey + f.r*.10, f.r*.20, .25, Math.PI - .25);
    ctx.stroke();

    ctx.globalAlpha = .45; ctx.fillStyle = '#FF8FA0';
    ctx.beginPath(); ctx.arc(-f.r*.58, f.r*.16, f.r*.13, 0, 6.284); ctx.fill();
    ctx.beginPath(); ctx.arc( f.r*.58, f.r*.16, f.r*.13, 0, 6.284); ctx.fill();
    ctx.globalAlpha = 1;

    ctx.restore();
  }

  function draw(){
    ctx.save();
    if (shake > .3) ctx.translate((Math.random()-.5)*shake, (Math.random()-.5)*shake);

    // 배경
    const g = ctx.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, '#FFF1E0'); g.addColorStop(1, '#FFD9B8');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

    // 통 안쪽
    ctx.fillStyle = '#FFFBF2';
    ctx.fillRect(BOX.l, BOX.t - 30, BOX.r - BOX.l, BOX.b - BOX.t + 30);

    // 위험선
    const warn = Math.min(1, overT / 1.5);
    ctx.save();
    ctx.setLineDash([9, 8]);
    ctx.lineWidth = 3;
    ctx.strokeStyle = warn > .01
      ? `rgba(255,90,80,${.45 + .55*Math.abs(Math.sin(performance.now()/160))})`
      : 'rgba(255,122,107,.55)';
    ctx.beginPath();
    ctx.moveTo(BOX.l, BOX.t); ctx.lineTo(BOX.r, BOX.t);
    ctx.stroke();
    ctx.restore();

    // 과일 (통 안쪽만 보이게)
    ctx.save();
    ctx.beginPath();
    ctx.rect(BOX.l, 0, BOX.r - BOX.l, BOX.b);
    ctx.clip();
    for (const b of balls) drawFruit(b.x, b.y, b.tier, b.pop);
    ctx.restore();

    // 통 테두리
    ctx.lineWidth = WALL; ctx.strokeStyle = INK; ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(BOX.l - WALL/2, BOX.t - 34);
    ctx.lineTo(BOX.l - WALL/2, BOX.b + WALL/2 - 14);
    ctx.quadraticCurveTo(BOX.l - WALL/2, BOX.b + WALL/2, BOX.l + 14, BOX.b + WALL/2);
    ctx.lineTo(BOX.r - 14, BOX.b + WALL/2);
    ctx.quadraticCurveTo(BOX.r + WALL/2, BOX.b + WALL/2, BOX.r + WALL/2, BOX.b + WALL/2 - 14);
    ctx.lineTo(BOX.r + WALL/2, BOX.t - 34);
    ctx.stroke();

    // 들고 있는 과일 + 안내선
    if (state === 'play') {
      const f = FRUIT[cur];
      if (cooldown <= 0) {
        ctx.save();
        ctx.setLineDash([5, 7]);
        ctx.lineWidth = 2.5; ctx.strokeStyle = 'rgba(42,49,69,.28)';
        ctx.beginPath();
        ctx.moveTo(aim, DROP_Y + f.r + 4); ctx.lineTo(aim, BOX.b - 4);
        ctx.stroke();
        ctx.restore();
        drawFruit(aim, DROP_Y, cur, 0);
      }
    }

    // 다음 과일
    ctx.save();
    rr(W - 84, 16, 68, 62, 14);
    ctx.fillStyle = 'rgba(255,255,255,.86)'; ctx.fill();
    ctx.lineWidth = 3; ctx.strokeStyle = INK; ctx.stroke();
    ctx.fillStyle = '#7A8296';
    ctx.font = '800 11px system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(T.next, W - 50, 32);
    ctx.save();
    ctx.translate(W - 50, 56);
    const s = Math.min(1, 17 / FRUIT[next].r);
    ctx.scale(s, s);
    drawFruit(0, 0, next, 0, true);
    ctx.restore();
    ctx.restore();

    // 조각과 글자
    for (const p of parts) {
      const a = Math.max(0, p.life / p.max);
      ctx.globalAlpha = a;
      if (p.txt) {
        ctx.font = '900 20px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.lineWidth = 4.5; ctx.strokeStyle = INK;
        ctx.strokeText(p.txt, p.x, p.y);
        ctx.fillStyle = '#FFF7EA'; ctx.fillText(p.txt, p.x, p.y);
      } else {
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r * a, 0, 6.284);
        ctx.fillStyle = p.c; ctx.fill();
      }
      ctx.globalAlpha = 1;
    }

    ctx.restore();
  }

  let last = 0;
  function frame(t){
    const dt = Math.min((t - last)/1000, .034);
    last = t;
    update(dt); draw();
    requestAnimationFrame(frame);
  }

  // ── 화면과 버튼 ─────────────────────────────────────
  const scReady = document.getElementById('scReady');
  const scOver = document.getElementById('scOver');
  const scPause = document.getElementById('scPause');
  const hScore = document.getElementById('hScore');
  const hBig = document.getElementById('hBig');
  const hBest = document.getElementById('hBest');
  const rScore = document.getElementById('rScore');
  const rBig = document.getElementById('rBig');
  const padL = document.getElementById('padL');
  const padR = document.getElementById('padR');

  function show(id){
    for (const s of [scReady, scOver, scPause]) s.classList.toggle('on', s.id === id);
  }
  function start(){
    reset();
    hScore.textContent = '0'; hBig.textContent = T.fruits[0];
    state = 'play';
    show('none');
  }
  function togglePause(){
    if (state === 'play') { state = 'pause'; show('scPause'); }
    else if (state === 'pause') { state = 'play'; show('none'); }
  }

  document.getElementById('btnStart').onclick = start;
  document.getElementById('btnRetry').onclick = start;
  document.getElementById('btnResume').onclick = togglePause;

  // 합쳐지는 순서 보여주기
  function buildChain(){
    const box = document.getElementById('chain');
    box.innerHTML = '';
    const names = T.fruits;
    FRUIT.forEach((f, i) => {
      if (i) { const u = document.createElement('u'); u.textContent = '›'; box.appendChild(u); }
      const el = document.createElement('i');
      const size = 11 + i * 1.6;
      el.style.width = el.style.height = size + 'px';
      el.style.background = f.c;
      el.title = names[i];
      box.appendChild(el);
    });
  }

  // 손가락과 마우스
  function aimFrom(e){
    const b = cv.getBoundingClientRect();
    aim = (e.clientX - b.left) / b.width * W;
    clampAim();
  }
  let pressing = false;
  cv.addEventListener('pointerdown', e => {
    if (state === 'ready' || state === 'over') { start(); return; }
    if (state !== 'play') return;
    pressing = true; aimFrom(e);
  });
  cv.addEventListener('pointermove', e => {
    if (state !== 'play') return;
    if (pressing || e.pointerType === 'mouse') aimFrom(e);
  });
  cv.addEventListener('pointerup', e => {
    if (!pressing) return;
    pressing = false; aimFrom(e); drop();
  });
  for (const ev of ['pointercancel','pointerleave'])
    cv.addEventListener(ev, () => { pressing = false; });

  // 키
  let hold = 0;
  addEventListener('keydown', e => {
    const k = e.key.toLowerCase();
    if (['arrowleft','arrowright','arrowup','arrowdown',' '].includes(k)) e.preventDefault();
    if (k === 'p') togglePause();
    if (k === 'arrowleft' || k === 'a') hold = -1;
    if (k === 'arrowright' || k === 'd') hold = 1;
    if (k === ' ' || k === 'enter') {
      if (state === 'ready' || state === 'over') start();
      else drop();
    }
  });
  addEventListener('keyup', e => {
    const k = e.key.toLowerCase();
    if ((k === 'arrowleft' || k === 'a') && hold === -1) hold = 0;
    if ((k === 'arrowright' || k === 'd') && hold === 1) hold = 0;
  });

  function padHold(el, dir){
    el.addEventListener('pointerdown', e => { e.preventDefault(); hold = dir; });
    for (const ev of ['pointerup','pointerleave','pointercancel'])
      el.addEventListener(ev, () => { if (hold === dir) hold = 0; });
  }
  padHold(padL, -1);
  padHold(padR, 1);
  document.getElementById('padDrop').addEventListener('click', () => {
    if (state === 'ready' || state === 'over') start(); else drop();
  });

  // 키로 옮기기
  setInterval(() => {
    if (hold && state === 'play') { aim += hold * 6; clampAim(); }
  }, 16);

  // ── 최고 기록 ───────────────────────────────────────
  // 기기에만 남는다. 서버로 보내지 않는다.
  const KEY = 'fruitBest';
  async function saveBest(v){
    try { await window.storage.set(KEY, String(v)); return; } catch (e) {}
    try { localStorage.setItem(KEY, String(v)); } catch (e) {}
  }
  (async () => {
    let raw = null;
    try { const r = await window.storage.get(KEY); raw = r && r.value; } catch (e) {}
    if (raw == null) { try { raw = localStorage.getItem(KEY); } catch (e) {} }
    if (raw) { best = parseInt(raw, 10) || 0; hBest.textContent = best; }
  })();

  reset();
  buildChain();
  requestAnimationFrame(frame);
})();
  </script>
</GameLayout>
